{
  "manifest_version": 3,
  "name": "JDGET",
  "description": "Extract job description information from recruiting sites and export it to Excel.",
  "version": "0.1.0",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "JDGET"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
