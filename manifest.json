{
  "manifest_version": 3,
  "name": "JOBGET",
  "description": "Extract job descriptions, collect favorites, and export recruiting intelligence to Excel.",
  "version": "1.1.0",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "JOBGET"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "sidePanel",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
